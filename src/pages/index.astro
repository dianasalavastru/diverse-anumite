---
/**
 * `/` — the Romanian Homepage (locale route map §11.1, Home / RO).
 *
 * RO is the default locale and is not prefixed (`prefixDefaultLocale: false`).
 * The page itself is composed in `components/homepage/Homepage.astro` so the two
 * locale routes cannot drift apart.
 */
import Homepage from '../components/homepage/Homepage.astro';
---

<Homepage locale="ro" />
