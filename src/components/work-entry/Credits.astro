---
/**
 * W-3 · Credits — the crediting block.
 *
 * OWNERSHIP: Workstream A (Work Entry).
 *
 * ── WHAT IT SHOWS, AFTER STAGE 3 ──────────────────────────────────────────
 * **Collaborators, and nothing else.** `CONTENT_MODEL.md` v3.1 §12 retires
 * Attribution, Commissioning, Roles and the scoped Authorship statement, and
 * §13 makes crediting the job of two plain optional lists — `Colaboratori` and
 * `Echipă`. None of the four is renamed or replaced, so no row stands in for
 * them and no fallback copy is invented.
 *
 * **Why Team is not here.** It is the model's other crediting field, but it
 * already renders — in the W-4 competition module when that module claims it,
 * and in Project Metadata otherwise (`modules.ts` `awardsAndTeamInCompetition`).
 * Adding it here would render it twice and break the "each field renders exactly
 * once" invariant `modules.test.ts` guards. Moving it here instead would be a
 * placement redesign, which retirement is not. Left where it is, deliberately.
 *
 * ── THE MODULE IS NOW CONDITIONAL ─────────────────────────────────────────
 * W-3 used to be unconditional, and could be, because Attribution was mandatory
 * so the block always had at least one row. With Attribution retired, an entry
 * with no Collaborators has nothing to credit — so the module follows the W-5
 * rule instead: it renders when it has content and is absent when it does not,
 * rather than printing an empty heading. The gate is `hasCredits()` in
 * `modules.ts`; this component never renders an empty `<dl>`.
 */
import type { Locale, WorkEntry } from '../../lib/content';
import type { WorkEntryMessages } from '../../lib/i18n/work-entry';

interface Props {
  entry: WorkEntry;
  /**
   * Unused since Stage 3: every value this block renders is now locale-neutral
   * (`metadata.collaborators` is a plain list of proper nouns). Kept on the prop so the call
   * site does not change, and so a localized crediting row can return without a signature edit.
   */
  locale: Locale;
  copy: WorkEntryMessages;
}

const { entry, copy } = Astro.props;
const labels = copy.credits;

interface Credit {
  readonly key: string;
  readonly value: string;
}

const collaborators: Credit | null = entry.metadata.collaborators.length
  ? { key: labels.collaborators, value: entry.metadata.collaborators.join(' · ') }
  : null;

const credits = [collaborators].filter((credit): credit is Credit => credit !== null);

---

<div class="we-credits">
  <dl class="cr-grid">
    {
      credits.map((credit) => (
        <div class="cr rv" data-rv="meta">
          <dt class="k">{credit.key}</dt>
          <dd class="v mono">{credit.value}</dd>
        </div>
      ))
    }
  </dl>
</div>
