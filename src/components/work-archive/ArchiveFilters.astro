---
/**
 * A-4 · Filters — COMPONENT_INVENTORY.md "Filter Group".
 *
 * Purpose: let a directed visitor narrow. Responsibility: "refine within scope;
 * **reduce complexity, don't expose taxonomy**." Inputs: "shared filters (Entry
 * Label + Sector) + the pillar-contextual Service refinement +
 * Year-as-sort." Notes: "no Attribution filter (F2); never duplicates curated
 * views."
 *
 * That input list IS this component, exactly — nothing more is offered and
 * nothing less. §22 records the set as "governed, not open", agreed verbatim by
 * IA Step 5, `WORK_ARCHIVE_PAGE_IA.md`:99 and the Inventory.
 *
 * ── THE CONTROL SHAPES, AND WHERE EACH COMES FROM ──────────────────────────
 * The HiFi's control vocabulary is a chip row plus quiet underlined selects, and
 * `WORK_ARCHIVE_IMPLEMENTATION_NOTES.md`:78 freezes the interaction shape:
 * "primary pillar tabs + contextual secondary chips + quiet search + result
 * count. Only the *meaning* of the secondary facet changes."
 *
 *   Label        → the chip row. It is the slot the HiFi's chip row is already
 *                  labelled for ("Tip"), and a two-value closed vocabulary is
 *                  what chips are for. Both values are always offered, even at
 *                  zero matches (see facets.ts).
 *   Sector       → a quiet select. Seven values since Stage 6 closed the axis,
 *                  and a select is the control that does not wrap into a wall.
 *                  Global to all three modes, and preserved across a switch.
 *   refinement   → the contextual Service select, scoped per option to the
 *                  active mode. It was a chip row; the archive filter shell
 *                  (DECISIONS_LOG #119) gives it the same quiet select as Sector
 *                  and sort, because a chip per Service ran to a second and third
 *                  line and could not sit in a 132px rail or one sheet row.
 *   sort         → the select the HiFi gave to `year`, per :64: "Replace the year
 *                  `<select>` filter with a sort control (`curated` · `newest` ·
 *                  `oldest`)."
 *
 * The HiFi's second select — `status` — is GONE, per :66: "Status is not exposed
 * as a public filter… exposing it can surface speculative or unbuilt flags out
 * of context."
 *
 * ── WHAT IS NOT HERE ───────────────────────────────────────────────────────
 * The quiet search field. `WORK_ARCHIVE_IMPLEMENTATION_NOTES.md`:119–124 leaves
 * its retrieval behaviour and "whether it ships at launch or as a fast-follow"
 * to be confirmed, and §22 keeps "search at launch vs fast-follow, and `?q=`
 * persistence" in "Safely open". It is also absent from §23.5's URL contract.
 * Shipping it would close an owner decision from the implementation layer, so
 * the slot is left empty and the decision is reported. Its visual contract is
 * frozen and unchanged; only the ship decision is outstanding.
 *
 * Every option list is built from the entries the archive actually holds (see
 * facets.ts), so a control never offers a value that matches nothing.
 */
import { type Locale, type ProjectLabel, type Sector } from '../../lib/content';
import { projectLabelLabel, sectorLabel } from '../../lib/i18n/vocabulary';
import type { WorkArchiveMessages } from '../../lib/i18n/work-archive';
import { ARCHIVE_SORTS, type ArchiveFacetValues } from './archive-state';
import type { ServiceOption } from './facets';

interface Props {
  locale: Locale;
  copy: WorkArchiveMessages['filters'];
  values: ArchiveFacetValues;
  services: readonly ServiceOption[];
}

const { locale, copy, values, services } = Astro.props;

const labels = values.labels.map((value) => ({
  value,
  label: projectLabelLabel(value as ProjectLabel, locale),
}));

const sectors = values.sectors.map((value) => ({
  value,
  label: sectorLabel(value as Sector, locale),
}));

const sorts = ARCHIVE_SORTS.map((value) => ({ value, label: copy.sort[value] }));

/* The first option of each select is the one the served page shows; the mirror below starts
   on it and the island keeps it in step. */
const firstSort = sorts[0]?.label ?? '';
---

{/* ── ONE SET OF CONTROLS, THREE LAYOUTS ─────────────────────────────────────
    The same four controls render at every width; `work-archive.css` only places
    them (DECISIONS_LOG #119):
      < 1024px      the existing disclosure panel — chips, then the quiet selects
      1024–1247px   the technical sheet — Etichete on one ruled row, Sector ·
                    Ordonare · Serviciu as key/value cells on the next
      ≥ 1248px      the left rail — one stacked group per facet
    Each facet carries its own visible key (`.wa-fk`). The narrow layout hides the
    keys, where the selects' own values already name the axis, as before.

    ── THE SELECT MIRROR ───────────────────────────────────────────────────
    A native select is as wide as its LONGEST option. Chromium can size it to the
    chosen one (`field-sizing: content`); Safari and Firefox cannot. `.sel-v`
    repeats the chosen option's text, and where `field-sizing` is unsupported the
    sheet sizes the cell from it and lays the transparent select over it
    (`@supports not (field-sizing: content)`). Decorative: the select itself is
    the control and carries the accessible name. */}
<div class="wa-filters" role="group" aria-label={copy.legend}>
  {/* Shared filter 1 — Project Label, global to all three pillar modes (v3.1 §10).
      `data-value=""` is "no refinement", checked by default, so the group always has a
      checked radio and the "off" state is itself a visible, announced option rather than
      the absence of one. The key is `aria-hidden`: the radiogroup already carries the name. */}
  <div class="wa-f wa-f--label">
    <span class="wa-fk" aria-hidden="true">{copy.label.legend}</span>
    <div class="wa-fv chips" role="radiogroup" aria-label={copy.label.legend} data-facet="label">
      <button type="button" class="chip on" role="radio" aria-checked="true" tabindex="0" data-value="">
        {copy.label.any}
      </button>
      {
        labels.map((option) => (
          <button
            type="button"
            class="chip"
            role="radio"
            aria-checked="false"
            tabindex="-1"
            data-value={option.value}
          >
            {option.label}
          </button>
        ))
      }
    </div>
  </div>

  <div class="wa-fsels">
    {/* Shared filter 2 — Sector. A native select: its state is announced by the platform,
        it is keyboard operable with no authored ARIA, and the selected option's own text
        names the axis when nothing is chosen. */}
    <div class="wa-f wa-f--sector">
      <label class="wa-fk" for="wa-f-sector">{copy.sector.legend}</label>
      <span class="wa-fv"><span class="sel">
        <select id="wa-f-sector" data-facet="sector">
          <option value="">{copy.sector.any}</option>
          {sectors.map((option) => <option value={option.value}>{option.label}</option>)}
        </select>
        <span class="sel-v" aria-hidden="true" data-sel-mirror>{copy.sector.any}</span>
      </span></span>
    </div>

    {/* Year as sort, never as filter (IA Step 5). */}
    <div class="wa-f wa-f--sort">
      <label class="wa-fk" for="wa-f-sort">{copy.sort.legend}</label>
      <span class="wa-fv"><span class="sel">
        <select id="wa-f-sort" data-facet="sort">
          {sorts.map((option) => <option value={option.value}>{option.label}</option>)}
        </select>
        <span class="sel-v" aria-hidden="true" data-sel-mirror>{firstSort}</span>
      </span></span>
    </div>

    {/* The pillar-contextual Service refinement — ONE control, scoped per option.

        Each option carries its Service's authored `pillar`, and the island offers only the
        options the active mode allows, by removing and restoring them (Safari ignores
        `hidden` on an <option>). One control, one copy of each option, every label and
        value in the served HTML. The default build state is `all`, so every option is
        present in the markup and the island only ever narrows. When the active mode
        offers no Service at all, the island hides this whole group: a control that can
        only say "any service" cannot do anything. */}
    <div class="wa-f wa-f--service" data-contextual="service">
      <label class="wa-fk" for="wa-f-service">{copy.service.legend}</label>
      <span class="wa-fv"><span class="sel">
        <select id="wa-f-service" data-facet="service">
          <option value="">{copy.service.any}</option>
          {services.map((option) => <option value={option.key} data-pillar={option.pillar}>{option.label}</option>)}
        </select>
        <span class="sel-v" aria-hidden="true" data-sel-mirror>{copy.service.any}</span>
      </span></span>
    </div>
  </div>
</div>
