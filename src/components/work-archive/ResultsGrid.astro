---
/**
 * A-5 · Results — COMPONENT_INVENTORY.md "Results Grid".
 *
 * Purpose: present matching work. Responsibility: "signposting previews, ordered
 * for discovery + balanced pillars". Inputs: a set of Work Preview Cards.
 * Outputs: → Work Entries. Notes: "signposting surface, never in-depth projects."
 *
 * WORK_ARCHIVE_WIREFRAME A-5: "the results region is the emotional and visual
 * center of the Archive — the work is the protagonist". So the grid owns the
 * presentation of the set (cells, sizes, order, which entry leads) and the card
 * owns the card.
 *
 * ── TWO PRESENTATIONS OF ONE SET ───────────────────────────────────────────
 * `register` selects between them, and it is the only switch:
 *
 *   on   the WORK ARCHIVE's project register — one project per row, each one an
 *        ARCHIVE FIELD (C-refined v3, #117): cover, up to three of the entry's
 *        own gallery images and a title block composed on one logical grid,
 *        mirrored side to side. The family and its slots come from the media
 *        set (`field.ts`), never from prominence; the five-size vocabulary is not
 *        consulted here at all (see A-5a).
 *   off  the CURATED VIEWS' masonry catalogue — the packed five-size grid,
 *        unchanged, with no preview sheet (a third of a cell is no place for
 *        three thumbnails) and the measured row-span engine still running.
 *
 * The CSS reads the same flag through `.wa-grid--register`, and the island reads
 * it through `data-archive-masonry`, so no third source can disagree with it.
 *
 * ── WHERE PROMINENCE WENT ──────────────────────────────────────────────────
 * Nowhere. `archiveSize` still runs for every cell on every surface and every
 * cell still carries its `s-*` class, because the curated views still lay out a
 * packed grid from it and `curation.prominence` is still editorial metadata
 * (`WORK_ARCHIVE_IMPLEMENTATION_NOTES.md`:104–113). What changed is that the
 * REGISTER no longer translates it into footprint: a register whose entries
 * differ in width is a register with a hierarchy of physical size in it, and the
 * whole point of the form is that the projects are peers. Prominence continues to
 * decide what a visitor meets FIRST, through `curated` order, which is the same
 * editorial lever expressed where a register can express it.
 *
 * ── WHAT THE CELL CARRIES, AND WHY ─────────────────────────────────────────
 * Three groups of attributes, each with one job:
 *
 *   `data-facet-*`  the item's own facets, as INDEPENDENT dimensions
 *                   (`WORK_ARCHIVE_IMPLEMENTATION_NOTES.md`:84 / §7.2 —
 *                   "do not merge them"). The HiFi's collapsed `data-type` +
 *                   `data-status` pair does not survive (§5.3, R6), and no
 *                   `status` or `attribution` attribute exists at all: neither is
 *                   a public filter (§23.5, F2), so neither is projected onto a
 *                   visitor-facing surface.
 *
 *   `data-rank-*`   the precomputed orderings (see masonry.ts). The client
 *                   SELECTS one; it never sorts. This is what makes "developers
 *                   do not re-order markup" (:113) structural.
 *
 *   `data-work`     the filter island's handle on a cell.
 *
 * The grid is also the whole page's no-JS baseline: rendered in discovery order
 * (§7.6), every entry present, every card a link. §14.0's progressive
 * enhancement is satisfied by the browse working before any script runs — which
 * is also exactly what IA Step 4 means by "browse is default".
 */
import WorkPreviewCard from '../WorkPreviewCard.astro';
import ArchiveField from './ArchiveField.astro';
import { localize, type Locale, type WorkArchiveItem } from '../../lib/content';
import { routePath } from '../../lib/i18n/routes';
import { itemFacets } from './facets';
import { archiveSize, computeArchiveRanks, type ArchiveRanks, type ArchiveScope } from './masonry';

interface Props {
  locale: Locale;
  /** Already locale-scoped and discovery-ordered by `ContentSource` (§7.1, §7.6). */
  items: readonly WorkArchiveItem[];
  /** The per-card continuation cue. */
  openLabel: string;
  /** Rendered only where the archive's filter island is mounted. */
  filterable?: boolean;
  /**
   * Present the set as the archive's PROJECT REGISTER rather than as the curated
   * views' masonry catalogue: one project per row, every row the same footprint,
   * alternating cover-left / cover-right down the page.
   *
   * A presentation flag, and only that. It changes no ordering, no membership, no
   * filter semantics and no URL — and it pins nothing: the alternation is read off
   * the CURRENT visible sequence, so after a filter or a re-sort the first result
   * is row A again, whichever entry that now is.
   */
  register?: boolean;
}

const { locale, items, openLabel, filterable = false, register = false } = Astro.props;

const ranks = computeArchiveRanks(items);

/**
 * The HiFi's `A·001` / `R·001` coordinate label: a running number within the
 * entry's own pillar, in curated order. It is an identity rather than a
 * position — it must not renumber when the visitor re-sorts — so it is bound to
 * the entry here, once, and travels with the card.
 *
 * Decorative and `aria-hidden` in the card. The letter is the pillar's initial
 * in the frozen identifier, not a translated label, so it is stable in both
 * locales.
 */
const PILLAR_INITIAL = { 'architecture-design': 'A', 'reality-capture': 'R' } as const;
const counters = { 'architecture-design': 0, 'reality-capture': 0 };

/** Authored plate tones, cycled — the HiFi paints a warm ground under each image. */
const TONES = ['#c9c4ba', '#cbc6bc', '#c6c1b7', '#cec9bf'];

const cells = items.flatMap((item, index) => {
  const slug = localize(item.slug, locale);
  const title = localize(item.title, locale);
  /* A card with no localized identity cannot link anywhere §11.2 guarantees
     exists. It is dropped rather than rendered as a dead card. */
  if (!slug || !title) return [];

  const pillar = item.pillar;
  counters[pillar] += 1;

  const facets = itemFacets(item, locale);
  const rank = ranks.get(item._id);

  return [
    {
      item,
      href: routePath('workEntry', locale, slug),
      size: archiveSize(item.curation.prominence, item.cover),
      coordinate: `${PILLAR_INITIAL[pillar]}·${String(counters[pillar]).padStart(3, '0')}`,
      place: localize(item.location, locale),
      tone: TONES[index % TONES.length] as string,
      facets,
      rank,
    },
  ];
});

const scopeRank = (rank: ArchiveRanks | undefined, scope: ArchiveScope): string | undefined => {
  const value = rank?.curated[scope];
  return value === undefined ? undefined : String(value);
};
---

{
  /*
   * ── TWO PRESENTATIONS, ONE GRID ──────────────────────────────────────────
   * `wa-grid--register` (the Work Archive) is the REGISTER: one project per row,
   * every row an Archive Field. `wa-grid` alone (the curated views) is the
   * masonry catalogue it has always been.
   *
   * `data-archive-masonry` is the island's handle on the difference. The
   * measured row-span engine exists to pack cells of unequal height into
   * shared columns; a register places one item per row, so a span there is at
   * best a no-op and at worst a hole. The flag is set from the same condition
   * that chooses the CSS, so the two cannot disagree.
   *
   * ── THE ALTERNATION, AND WHY IT IS AN INDEX ──────────────────────────────
   * `data-row` is `a` on even positions and `b` on odd ones, and `b` mirrors the
   * field's columns. Its rows, its slots and its crops are unchanged — the field
   * emits both placements and the stylesheet picks one from this attribute.
   *
   * It is deliberately the VISIBLE POSITION and nothing else. Not pillar, not
   * entry type, not prominence, not the cover's orientation, not a build-time
   * index frozen into the markup: any of those would make the rhythm an accident
   * of content, and would break the moment a filter removed an entry. The server
   * renders discovery order, the island re-marks after every state change, and
   * the answer to "which way does this row face" is always "count the rows above
   * it that are showing".
   */
}
<div
  class:list={['wa-grid', register && 'wa-grid--register']}
  data-archive-grid={filterable ? '' : undefined}
  data-archive-register={register ? '' : undefined}
  data-archive-masonry={register ? undefined : ''}
>
  {
    cells.map((cell, index) => (
      <article
        class:list={['wa-item', 'rv', `s-${cell.size}`]}
        data-rv="img"
        data-work=""
        data-row={register ? (index % 2 === 0 ? 'a' : 'b') : undefined}
        data-facet-pillars={cell.facets.pillars.join(' ')}
        data-facet-labels={cell.facets.labels.join(' ')}
        data-facet-sectors={cell.facets.sectors.join(' ')}
        data-facet-services={cell.facets.services.join(' ')}
        data-rank-curated-all={scopeRank(cell.rank, 'all')}
        data-rank-curated-architecture-design={scopeRank(cell.rank, 'architecture-design')}
        data-rank-curated-reality-capture={scopeRank(cell.rank, 'reality-capture')}
        data-rank-newest={cell.rank ? String(cell.rank.newest) : undefined}
        data-rank-oldest={cell.rank ? String(cell.rank.oldest) : undefined}
      >
        {register ? (
          <ArchiveField
            item={cell.item}
            locale={locale}
            href={cell.href}
            coordinate={cell.coordinate}
            place={cell.place}
            openLabel={openLabel}
            tone={cell.tone}
            priority={index === 0}
          />
        ) : (
          <WorkPreviewCard
            variant="archive"
            entry={cell.item}
            locale={locale}
            href={cell.href}
            coordinate={cell.coordinate}
            place={cell.place}
            openLabel={openLabel}
            tone={cell.tone}
          />
        )}
      </article>
    ))
  }
</div>
