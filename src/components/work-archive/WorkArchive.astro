---
/**
 * The Work Archive — composed once, rendered per locale.
 *
 * OWNERSHIP: Workstream A. Phase 5 of TECHNICAL_ARCHITECTURE.md §23.2:
 * "**Work Archive** — filter contract, URL state, masonry engine."
 *
 * MODULE ORDER is the wireframe's two-region structure, which is the Page IA's
 * discovery cycle: a **control region** (A-1 orientation · A-2 pillar toggle ·
 * A-3 active context · A-4 filters) framing a **results region** (A-5 results,
 * or A-6 when nothing matches), with A-7 continue affordances throughout.
 * "The control region **frames** the results; the results are the protagonist."
 *
 * ── CONTENT: THE SAME I-3 SWAP POINT ──────────────────────────────────────
 * Every content-shaped value comes from `ContentSource`. Locale scoping (§7.1)
 * and discovery order (§7.6) happen inside the source, before anything reaches a
 * component — this file selects and arranges, it does not define. Swapping
 * fixtures for Sanity is the one call below, and nothing else on this page moves.
 *
 * ── WHAT THIS PAGE DELIBERATELY DOES NOT DO ───────────────────────────────
 *   - It does not persuade. `WORK_ARCHIVE_PAGE_IA.md` §1: "Does not persuade —
 *     it enables exploration, not conversion." There is no CTA to Contact;
 *     Contact is reachable only through the global nav.
 *   - It does not present a project. Results are signposts that route to Work
 *     Entries.
 *   - It carries **no coordinate rail** — the rail is present in five HiFis and
 *     absent from this one (see layout.css), so none is added.
 *
 * ── THE ISLAND IS AN ENHANCEMENT ──────────────────────────────────────────
 * Rendered static, this page is the complete archive in discovery order, every
 * card a link — which is the browse IA Step 4 makes the default and the state
 * §12 needs for crawlers ("client-side filtering never hides content from
 * crawlers"). The filter controls are the enhancement layered on top, and the
 * `<noscript>` rule below hides them when the enhancement cannot run, rather than
 * leaving inert controls on the page. Nothing else about the page changes.
 */
import ActiveContext from './ActiveContext.astro';
import ArchiveContinue from './ArchiveContinue.astro';
import ArchiveEmptyState from './ArchiveEmptyState.astro';
import ArchiveFilters from './ArchiveFilters.astro';
import ArchiveOrientation from './ArchiveOrientation.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PillarToggle from './PillarToggle.astro';
import ResultsGrid from './ResultsGrid.astro';
import ViewTransition from '../ViewTransition.astro';

import { PILLARS, type Locale } from '../../lib/content';
import { routePath } from '../../lib/i18n/routes';
import { workArchiveMessages } from '../../lib/i18n/work-archive';
import { collectFacetValues, itemFacets, serviceOptions } from './facets';

/* ── I-3, SWAPPED — this import and this call, nothing else ───────────────── */
import { contentSource } from '../../lib/content/build-source';
const source = contentSource();
/* ─────────────────────────────────────────────────────────────────────────── */

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = workArchiveMessages(locale);

const [items, services, hasCompetitions] = await Promise.all([
  source.workArchive(locale),
  source.serviceSummaries(locale),
  // The Competitions launch-withholding gate (A-7 link) — see `pages/proiecte/concursuri.astro`.
  source.hasCompetitions(locale),
]);

/** Option lists projected from the rendered set — never from the full vocabulary. */
const values = collectFacetValues(items, locale);
const serviceChoices = serviceOptions(services, values.services, locale);

/**
 * The masthead's quiet secondary readout: how the total divides across the two
 * pillars.
 *
 * MEASURED, not authored. Membership is `itemFacets`' own pillar projection —
 * the same primary + secondary rule the pillar tab filters on — so the number
 * printed here is exactly the number the visitor gets by pressing that tab, and
 * a cross-pillar entry is counted in both views because that is where it
 * appears. The two counts therefore need not sum to the total, and must not be
 * made to: `CONTENT_MODEL.md`:63's composite entry is one entry in two scopes.
 *
 * IA §3.2 forbids structural primacy between the pillars, so they are read from
 * the frozen `PILLARS` order and rendered identically.
 */
/* Per-scope totals for the pillar tabs — the same membership rule the island filters by
   (`itemFacets(...).pillars`, primary + secondary), so a tab's number is exactly what
   selecting it shows. */
const counts: Record<string, number> = { all: items.length };
for (const pillar of PILLARS) {
  counts[pillar] = items.filter((item) => itemFacets(item, locale).pillars.includes(pillar)).length;
}

const basePath = routePath('workArchive', locale);
---

<BaseLayout
  locale={locale}
  rhythm="work-archive"
  routeKey="workArchive"
  title={copy.meta.title}
  description={copy.meta.description}
>
  <Fragment slot="head">
    {/* §14.0, progressive enhancement. Two resolutions, both no-JS only:
        the reveal system leaves cells hidden if the runtime never runs, and the
        filter controls cannot filter anything without the island — an inert
        control that looks operable is worse than an absent one, and the archive
        below it is already complete and browsable. */}
    <noscript>
      <style>
        .wa-controls {
          display: none;
        }
        .wa-item.rv {
          opacity: 1 !important;
          clip-path: none !important;
        }
      </style>
    </noscript>
  </Fragment>

  <ViewTransition />

  <div class:list={['wa', items.length > 0 && 'wa--board']} data-archive data-archive-base={basePath}>
    <ArchiveOrientation
      locale={locale}
      eyebrow={copy.orientation.eyebrow}
      heading={copy.orientation.heading}
      statement={copy.orientation.statement}
      total={items.length}
      totalLabel={copy.orientation.total}
      showTotal={false}
    />

    {/* The control region: quiet, consistent, and never louder than the work
        (WORK_ARCHIVE_WIREFRAME, "Visual emphasis hierarchy"). */}
    {/* ── THE BOARD (DECISIONS_LOG #119) ────────────────────────────────────
        One set of controls and one results region, placed by CSS in three regimes:
          < 1024px      the control band as before — tabs, the "Filtre" disclosure,
                        the panel it opens, the active context — above the results
          1024–1247px   the tab row (sticky) over the technical sheet, both on the
                        Project field's own centred frame, above the results
          ≥ 1248px      the tab row across the board, the sticky filter rail beside
                        the results; rail + field are one centred composition
        `.wa-controls` keeps its band below 1024px and dissolves (`display: contents`)
        above it, so its two children become the board's own grid items. `.wa-side`
        holds the panel and the active context together, so the rail carries both and
        the narrow layout keeps the context visible while the panel is closed.
        With no entries there is nothing to refine: no disclosure, no panel, no rail. */}
    <div class:list={['wa-board', items.length > 0 && 'wa-board--refinable']}>
      <div class="wa-controls bleed">
        {/* Primary: the pillar tabs, always visible. Secondary: every refinement — behind
            one quiet disclosure on narrow screens, always shown from 1024px. */}
        <div class="frow wa-primary wa-framed">
          <PillarToggle locale={locale} copy={copy.pillar} counts={counts} />
          {items.length > 0 && (
          <button
            type="button"
            class="wa-ftoggle"
            aria-expanded="false"
            aria-controls="wa-filter-panel"
            data-filter-toggle
          >
            {copy.filters.legend}
            <span class="n" data-filter-count hidden></span>
            <span class="ar" aria-hidden="true">▾</span>
          </button>
          )}
        </div>

        <div class="wa-side wa-framed">
          {items.length > 0 && (
            <div class="wa-fpanel" id="wa-filter-panel" data-filter-panel>
              <ArchiveFilters
                locale={locale}
                copy={copy.filters}
                values={values}
                services={serviceChoices}
              />
            </div>
          )}

          <ActiveContext
            locale={locale}
            copy={copy.activeContext}
            count={copy.count}
            total={items.length}
          />
        </div>
      </div>

      <section class="wa-results" aria-labelledby="wa-results-heading" tabindex="-1" data-archive-region>
        <h2 class="wa-sr" id="wa-results-heading">{copy.results.label}</h2>

        <ResultsGrid
          locale={locale}
          items={items}
          openLabel={copy.results.open}
          filterable
          register
        />

        <ArchiveEmptyState
          locale={locale}
          copy={copy.empty}
          wholeArchiveLabel={copy.continue.fullArchive}
          basePath={basePath}
        />
      </section>
    </div>

    <ArchiveContinue
      locale={locale}
      copy={copy.continue}
      current="workArchive"
      hasCompetitions={hasCompetitions}
    />
  </div>

  <script>
    import '../../scripts/islands/work-archive';
  </script>
</BaseLayout>
