---
/**
 * S-2 · Problem & fit (Page IA Stage B).
 *
 * Responsibility (`SERVICE_PAGE_IA.md` S-2): "help visitors recognize their own
 * problem and whether this service is their solution (what it solves, who it's
 * for)."
 *
 * Components (`SERVICE_WIREFRAME.md` S-2): "Section Introduction (framing) ·
 * Rich Text (what the service solves + who it's for + use-cases)."
 *
 * Spatial composition, transcribed: "prose-led, focused on the **visitor's**
 * situation rather than the service's description; use-cases presented as a
 * calm, evenly-weighted set. One idea — 'is this my problem?' — resolved before
 * moving on."
 *
 * ── WHICH FIELDS, AND WHY THIS ONE READING ────────────────────────────────
 * `problemSolved` is unambiguous: `types.ts` marks it "What the service solves +
 * use-cases (S-2)", and the Studio field is titled "What it solves, and who it
 * is for". `sectors` is equally clear — "Sector-relevant use-cases (S-2)".
 *
 * `description` is the one field `types.ts` leaves open ("long-form explanation
 * (S-2/S-3)"). It resolves here, for the reason `modules.ts` records: S-2 is the
 * prose module and S-3 is the concrete one, and the service's own account of
 * what it *is* answers the Page IA's first listed visitor question — "What
 * exactly is this service, and what does it solve?" It reads first, as the
 * framing the wireframe's "Section Introduction" asks for, and `problemSolved`
 * follows it as the recognition prose. Nothing is duplicated across modules: a
 * field renders in exactly one place.
 *
 * ── SECTORS ARE USE-CASES HERE, NOT FILTERS ───────────────────────────────
 * IA Step 5 makes Sector a filter **on the Archive**. On a Service page it is
 * display: the evenly-weighted set the wireframe describes, rendered through the
 * shared `sectorLabel` map so an unknown authored value is de-slugged rather than
 * dropped or invented (see vocabulary.ts). They are not links — linking each to a
 * filtered archive would turn the page's problem-recognition module into a browse
 * surface, which is the Archive's responsibility, not this page's.
 */
import RichText from '../RichText.astro';
import { localize } from '../../lib/content';
import type { Locale, Service } from '../../lib/content';
import type { ServiceMessages } from '../../lib/i18n/service';
import { sectorLabel } from '../../lib/i18n/vocabulary';

interface Props {
  service: Service;
  locale: Locale;
  copy: ServiceMessages;
}

const { service, locale, copy } = Astro.props;

const description = localize(service.description, locale);
const problem = localize(service.problemSolved, locale);
const sectors = service.sectors;
---

<div class="sv-problem">
  {
    description && (
      <div class="sv-lead rv" data-rv="meta">
        <RichText blocks={description} />
      </div>
    )
  }

  {
    problem && (
      <div class="sv-problem-body rv" data-rv="meta">
        <RichText blocks={problem} />
      </div>
    )
  }

  {
    sectors.length > 0 && (
      <div class="sv-usecases rv" data-rv="meta">
        <h3 class="sv-sublabel mono">{copy.problem.useCases}</h3>
        <ul class="sv-usecase-list">
          {sectors.map((sector) => (
            <li>{sectorLabel(sector, locale)}</li>
          ))}
        </ul>
      </div>
    )
  }
</div>
