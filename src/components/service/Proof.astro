---
/**
 * S-4 · Proof / demonstrated work (Page IA Stage D).
 *
 * Responsibility (`SERVICE_PAGE_IA.md` S-4): "**trust through relevant
 * evidence** — proof must demonstrate **this specific service**, never simply
 * show unrelated projects. Demonstrate, don't browse (protects the Work
 * Archive's responsibility)."
 *
 * Components (`SERVICE_WIREFRAME.md` S-4): "Section Header · Work Preview Card
 * ×n (the demonstrating Work Entries) · CTA Group ('see more' → pillar-filtered
 * Work Archive)." Spatial composition: "the work is the protagonist… presented
 * as proof of *this* service, not a general gallery. **This module is the
 * decisive proof moment of the page.**"
 *
 * ── THE PROOF SET IS DERIVED, NEVER AUTHORED HERE ─────────────────────────
 * `Service.demonstratedBy` is reversed from `WorkEntry.services` by the query
 * layer (`DECISIONS_LOG.md` #36/#38: "one canonical Service object referenced,
 * not copied" — the Service holds no list of its own). It arrives already
 * locale-scoped and curation-ordered (`source.ts` `scopeService`), so this
 * component neither filters nor sorts: doing either would be a second, quieter
 * curation layer the owner cannot see or change.
 *
 * Locale scoping matters here more than anywhere else on the page. Under `/en/`
 * the set contains only EN-published entries, so a proof card can never link to
 * a Work Entry that §11.2 guarantees does not exist — and an RO-rich, EN-thin
 * service correctly renders no S-4 in EN while showing its proof in RO.
 *
 * ══════════════════════════════════════════════════════════════════════════
 *  #104 — NO DEMONSTRATING ENTRIES, NO MODULE
 * ══════════════════════════════════════════════════════════════════════════
 *
 * `DECISIONS_LOG.md` #104 supersedes F5's surface switch. `ServicePage.astro`
 * mounts this module only when `modules.ts` `hasProof` is true, so there is no
 * empty-state branch here: no editorial note, no Contact CTA, no Hub back-path
 * (S-5 carries both), and never an empty grid, carousel or counter. The guard
 * below is defensive only — the predicate and the card filter are the same test.
 *
 * ── "SEE MORE" USES THE FROZEN FILTER CONTRACT ────────────────────────────
 * Page IA S-4: module "see more" → the **pillar-filtered Work Archive**. The
 * pillar token comes from the single declaration in `vocabulary.ts`; nothing is
 * concatenated from a Pillar value. For a Reality Capture service the link also
 * narrows by Service, and the value is the Service's machine **key**: since
 * Stage 8 `archive-state.ts` validates `?service=` against `ServiceKey`s, so the
 * localized slug this used to send was silently discarded. A&D keeps the pillar
 * filter alone (unchanged behaviour); the archive would accept the key there too
 * — widening the narrowing to A&D is an open decision, not a bug fix.
 *
 * ── A STRIP, NOT A GRID (Capability Sheet) ────────────────────────────────
 * The proof set was a three-across grid of the same card the Work Archive
 * uses at the same size. At that scale it *is* a miniature archive embedded in
 * the Service page — which is precisely the responsibility boundary S-4 names
 * ("demonstrate, don't browse — protects the Work Archive's responsibility").
 *
 * It is now a compact strip: more items across, each one small, on one ruled
 * row. Restraint is expressed as SIZE rather than as count, so a service with
 * six demonstrating projects still shows six — hiding real proof to look
 * restrained would be the wrong trade — but none of them competes with the
 * capability the page just explained. The card component is untouched; only the
 * set's composition changed, which is the Results Grid principle the Inventory
 * already establishes (sizing belongs to the surface presenting the set).
 *
 * ── THE POINT-CLOUD FIELD MOVED TO S-3 ────────────────────────────────────
 * It used to sit at the head of this set. A cloud is a demonstration that the
 * *capability* exists and produces inspectable output, which is the
 * capabilities station's job, not proof-of-delivery. See `Capabilities.astro`.
 * `modules.ts` `captureSubject` still owns the selection rule.
 */
import WorkPreviewCard from '../WorkPreviewCard.astro';
import { localize } from '../../lib/content';
import type { Locale, Service } from '../../lib/content';
import type { ServiceMessages } from '../../lib/i18n/service';
import { routePath } from '../../lib/i18n/routes';
import { pillarArchiveParam, pillarLabel } from '../../lib/i18n/vocabulary';

interface Props {
  service: Service;
  locale: Locale;
  copy: ServiceMessages;
}

const { service, locale, copy } = Astro.props;

const pillar = service.pillar;
const pillarName = pillarLabel(pillar, locale);

/**
 * One card per demonstrating entry. An entry whose slug is missing in this
 * locale cannot be linked and is dropped — the query layer's scoping makes that
 * a type guard rather than an expected state, and a card with no destination
 * would be proof the visitor cannot open.
 */
const cards = service.demonstratedBy
  .map((entry) => {
    const slug = localize(entry.slug, locale);
    return slug ? { entry, href: routePath('workEntry', locale, slug) } : null;
  })
  .filter((card): card is NonNullable<typeof card> => card !== null);

/**
 * §23.5's frozen URL. `?service=` carries the stable machine KEY (v3.1 §14.3) —
 * the value `archive-state.ts` validates — never the editable localized slug.
 */
const seeMoreParams = new URLSearchParams({ pillar: pillarArchiveParam(pillar) });
if (pillar === 'reality-capture') seeMoreParams.set('service', service.key);
const seeMoreHref = `${routePath('workArchive', locale)}?${seeMoreParams.toString()}`;
---

{
  cards.length > 0 && (
    <div class="sv-proof">
      <ul class="sv-proof-strip" aria-label={copy.proof.listLabel}>
        {cards.map((card, index) => (
          <li class="sv-proof-item rv" data-rv="img">
            <WorkPreviewCard
              entry={card.entry}
              locale={locale}
              href={card.href}
              index={index + 1}
            />
          </li>
        ))}
      </ul>

      <p class="sv-see-more rv" data-rv="meta">
        <a class="sv-more" href={seeMoreHref}>
          {copy.proof.seeMore.replace('{pillar}', pillarName)}
          <span class="ar" aria-hidden="true">
            →
          </span>
        </a>
      </p>
    </div>
  )
}
