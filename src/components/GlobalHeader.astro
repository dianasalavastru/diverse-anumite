---
/**
 * Global Header — COMPONENT_INVENTORY.md §4.
 *
 * Purpose: persistent global wayfinding.
 * Responsibility: Layer-2 task-first nav, NEVER shape-shifting
 *   (NAV_DECISION_RECORD.md §3: "it never shape-shifts" between the homepage
 *   and interior pages).
 * Inputs: global nav items (Despre · Servicii · Proiecte · Contact · EN).
 * Notes: additive to the homepage narrative; pillar hubs are NOT items here
 *   (NAV_DECISION_RECORD.md §5.2 — hubs stay reachable via the homepage fork,
 *   deep links and contextual back-paths).
 *
 * Styling lives in src/styles/components/global-header.css, inside the
 * `components` cascade layer.
 *
 * ── THE SMALL-VIEWPORT PANEL ───────────────────────────────────────────────
 * Below 720px the horizontal nav is `display: none` and the `menu` control
 * takes its place. That control used to render `disabled` with no panel behind
 * it, which meant the entire global navigation — all four task links AND the
 * language toggle — was unreachable by pointer, touch and keyboard alike at
 * every small viewport. Only the wordmark survived. §14.0 ("no interactive
 * surface may become unreachable") was being broken by the header itself.
 *
 * The panel below is that missing surface. It is a plain disclosure: a native
 * <button> carrying `aria-expanded`/`aria-controls`, and a normal <nav> of
 * normal links. NOT `role="menu"` — that pattern owes arrow-key roving focus and
 * typeahead, and these are page links, not menu commands (APG: "menu" is for
 * application actions; site navigation stays a nav of links).
 *
 * It renders as a SIBLING of <header>, not a child, and that is deliberate:
 * every existing rule in global-header.css and motion.css is written
 * `.site-header nav …`, so nesting the panel's <nav> inside the header would
 * silently inherit the desktop row's display, gap, type scale AND its
 * `display: none` below 720px. As a sibling, not one existing selector changes
 * meaning, so the approved desktop header is untouched by construction.
 *
 * Both navs render from the SAME `items` array, the same `isCurrent`, the same
 * `routePath` and the same `counterpart` prop. There is no second route map.
 *
 * NOT YET BUILT (deliberately, and out of scope for the I-1 foundation):
 *   - the Servicii pillar-grouped dropdown (COMPONENT_INVENTORY.md §4 lists it
 *     as an input; it depends on the Service objects, which are Workstream B).
 */
import { ui } from '../lib/i18n/ui';
import { routePath, type Locale, type RouteKey } from '../lib/i18n/routes';

interface Props {
  locale: Locale;
  /** The route currently rendered — marks the matching nav item as current. */
  current?: RouteKey;
  /** `on-hero` = the page opens on a full-bleed dark hero (Work Entry, Service). */
  variant?: 'default' | 'on-hero';
  /**
   * Path of this page in the other locale, or `null` when the entity has no
   * counterpart. §11.2 rule 5: the switcher is DISABLED with an accessible
   * explanation — never a link that falls back to RO.
   */
  counterpart?: string | null;
  /** The other locale, for the switcher's `hreflang`/`lang`. */
  counterpartLocale: Locale;
}

const {
  locale,
  current,
  variant = 'default',
  counterpart = null,
  counterpartLocale,
} = Astro.props;

const t = ui(locale);

/**
 * `language.label` in each locale's messages names the OTHER locale — the RO
 * page offers "EN", the EN page offers "RO" (NAV_DECISION_RECORD.md §4, "+
 * language toggle"). So it is read from the CURRENT locale's messages.
 */
const toggleLabel = t.language.label;

const items: { key: RouteKey; label: string }[] = [
  { key: 'about', label: t.nav.about },
  { key: 'services', label: t.nav.services },
  { key: 'workArchive', label: t.nav.workArchive },
  { key: 'contact', label: t.nav.contact },
];

/**
 * The Work Archive item stays current across its curated views and entries.
 *
 * `professionalExperience` is inert: that view is permanently retired (Stage 2,
 * `DECISIONS_LOG.md` #97) and ships no page, so no page can ever pass it as `current`. The key
 * stays in the frozen route table for one reason — keeping its two localized slugs reserved —
 * and it is listed here only so this set continues to mirror the table rather than a subset of
 * it. It is not a navigation destination and never was: the header links `workArchive`.
 */
const workRoutes: RouteKey[] = [
  'workArchive',
  'workEntry',
  'competitions',
  'professionalExperience',
];

function isCurrent(key: RouteKey): boolean {
  if (!current) return false;
  if (key === 'workArchive') return workRoutes.includes(current);
  if (key === 'services') return current === 'services' || current === 'service';
  return current === key;
}
---

<header class:list={['site-header', variant === 'on-hero' && 'on-hero']}>
  <a class="wm" href={routePath('home', locale)}>diverse anumite</a>

  <nav aria-label={t.primaryNavigation}>
    {
      items.map((item) => (
        <a
          href={routePath(item.key as never, locale, undefined as never)}
          class:list={[isCurrent(item.key) && 'here']}
          aria-current={isCurrent(item.key) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }

    {
      counterpart ? (
        <a class="en" href={counterpart} hreflang={counterpartLocale} lang={counterpartLocale}>
          {toggleLabel}
        </a>
      ) : (
        <span
          class="en"
          aria-disabled="true"
          lang={counterpartLocale}
          title={t.language.unavailable || undefined}
        >
          {toggleLabel}
        </span>
      )
    }
  </nav>

  <button
    class="menu"
    type="button"
    aria-expanded="false"
    aria-controls="site-menu"
    data-label-open={t.menu}
    data-label-close={t.menuClose}>{t.menu}</button>
</header>

{/* The panel is closed by CSS (`visibility: hidden`), not by an attribute the
    runtime has to arrive and set — so it is closed, and its links are out of the
    tab order, from the very first paint and however late the module loads. At
    721px and up it is `display: none` outright and costs nothing. */}
<div class="menu-panel" id="site-menu">
  <nav aria-label={t.primaryNavigation}>
    {
      items.map((item) => (
        <a
          href={routePath(item.key as never, locale, undefined as never)}
          class:list={[isCurrent(item.key) && 'here']}
          aria-current={isCurrent(item.key) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }

    {
      counterpart ? (
        <a class="en" href={counterpart} hreflang={counterpartLocale} lang={counterpartLocale}>
          {toggleLabel}
        </a>
      ) : (
        <span
          class="en"
          aria-disabled="true"
          lang={counterpartLocale}
          title={t.language.unavailable || undefined}
        >
          {toggleLabel}
        </span>
      )
    }
  </nav>
</div>

<script>
  import '../scripts/islands/global-nav';
</script>
